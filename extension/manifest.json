{
  "manifest_version": 3,
  "name": "Link Reuse",
  "version": "3.1.3",
  "description": "Reuse existing tabs for external links using observed redirects and same-resource URLs stored locally.",
  "permissions": [
    "webNavigation",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "interaction.js",
        "canonical.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed",
  "key": ""
}
